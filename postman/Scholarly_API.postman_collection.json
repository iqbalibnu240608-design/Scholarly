        },
        {
          "name": "Switch Role Instan (Auto-Update Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.token) {",
                  "        pm.environment.set('auth_token', res.token);",
                  "        console.log('Switched to:', res.user.role, 'Token:', res.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"kantin\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/switch-role", "host": ["{{base_url}}"], "path": ["auth", "switch-role"] }
          }
        },
